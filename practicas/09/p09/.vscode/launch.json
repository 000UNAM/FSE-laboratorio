{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar estadistica",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/estadistica",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "make",
      "setupCommands": [
        {
          "text": "set debuginfod enabled off",
          "ignoreFailures": true
        },
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Depurar Centinela",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/centinela_dbg",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "make",
      "setupCommands": [
        {
          "text": "set debuginfod enabled off",
          "ignoreFailures": true
        },
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
